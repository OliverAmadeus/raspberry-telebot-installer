
[Unit]
Description=Raspberry Telebot - Telegram Remote Terminal
Wants=network-online.target
After=network-online.target

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple

User=raspberry-telebot
Group=raspberry-telebot

WorkingDirectory=/opt/raspberry-telebot-installer/bot

Environment=HOME=/var/lib/raspberry-telebot
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1

EnvironmentFile=/etc/raspberry-telebot-installer/bot.env

ExecStart=/opt/raspberry-telebot-installer/venv/bin/python /opt/raspberry-telebot-installer/bot/bot.py

Restart=on-failure
RestartSec=10

# SEGURIDAD
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
LockPersonality=true

# PERMISOS DE ESCRITURA
ReadWritePaths=/var/lib/raspberry-telebot

StateDirectory=raspberry-telebot
StateDirectoryMode=0750

UMask=0077

TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
